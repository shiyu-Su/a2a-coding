{
  "name": "@a2a-coding/orch",
  "version": "0.8.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "bridge": "npm run build && node dist/bridge/index.js",
    "bridge:start": "node scripts/bridgectl.mjs start",
    "bridge:stop": "node scripts/bridgectl.mjs stop",
    "bridge:restart": "node scripts/bridgectl.mjs restart",
    "bridge:status": "node scripts/bridgectl.mjs status",
    "bridge:logs": "node scripts/bridgectl.mjs logs",
    "lint": "eslint .",
    "test": "npm run build && node --test \"dist/test/*.test.js\" \"test/*.test.mjs\"",
    "test:proc": "node --test test/proc.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0"
  }
}
