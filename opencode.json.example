{
  "$schema": "https://opencode.ai/config.json",
  // 一座桥、多个编排身份（v0.8.6 起）：组身份由 url 路径首段承载，下列两种形态**二选一**启用。
  // 形态 A —— 未配组环境的全量入口（桥配置里没有 projectGroup 组时用它；配了组则被 403 group_identity_required 拒绝）：
  "mcp": {
    "a2a": {
      "type": "remote",
      "url": "http://127.0.0.1:8787/mcp",
      "enabled": true
    }
    // 形态 B —— 组身份（桥已配置该组时启用；视野限定本组项目 / 任务 / Feature / 事件）。
    // 键名任意，可并存多条；组名字符集 [A-Za-z0-9_-]+，不得为保留首段 health / shutdown / runner / mcp：
    // ,"a2a-teamA": {
    //   "type": "remote",
    //   "url": "http://127.0.0.1:8787/teamA/mcp",
    //   "enabled": true
    // }
    // ⚠ 组不是安全边界：桥端点零鉴权，组名段只界定该连接的可见性与派发范围。
  },
  "instructions": [
    "flow/spec/需求流程.md",
    "flow/spec/引擎映射.md"
  ]
}
