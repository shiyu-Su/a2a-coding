{
  "_comment": "可选字段：listenHost（v0.7.0 起缺省 127.0.0.1 = Launcher 仅绑本机 loopback；跨机直连需显式改回 0.0.0.0 并自行加反向代理鉴权）。启用 shutdownEndpoint=true 时建议保持 listenHost=127.0.0.1，并由反向代理 deny /shutdown（反代转发后源地址为 loopback，会绕过 loopback 校验）。launcher.bridge（v0.7.0 Runner 反向注册）：整段省略 = 不启动 Runner 出站（零出站、同现状）；一旦写出本段，url 与 token 必须同时为非空字符串，缺一即启动 fail-fast（配置解析期抛错、进程退出）。url = 桥常驻 HTTP transport 基址（不含路径；Runner 在其上拼 /runner/register · /runner/connect · /runner/result，要求桥以 transport.mode=http 常驻，stdio 形态不承载 /runner/*）；token = per-machine 静态 Bearer，须与 orch 侧 machines[].token 一致。",
  "machineId": "<machine-id>",
  "launcher": {
    "port": 3100,
    "listenHost": "127.0.0.1",
    "idleStopMs": 300000,
    "startupCheck": true,
    "startupCheckTimeoutMs": 120000,
    "shutdownEndpoint": false,
    "bridge": { "url": "http://<host>:8787", "token": "<runner-bearer-token>" }
  },
  "projects": [
    {
      "_comment": "可选：A2A push 回调能力（按机器/项目 opt-in，默认不开启）。将 agentConfig.agentCard.pushNotifications 设为 true 即对本项目开启；缺省或写 false = 不开启（沿用轮询对账）。回调 url/token 无需在此配置——由 orch 经 A2A message/send 的 configuration.taskPushNotificationConfig 内联下发，故无需改 ensure 或线协议。仅限同机/受信网络使用；跨机回调鉴权待 v0.7.0。",
      "projectId": "<project-id>",
      "workspace": "<absolute path to the project on this machine>",
      "agentKind": "opencode",
      "a2aPort": 3010,
      "risk": "write",
      "_agentConfigComment": "本条目 agentConfig 为键位说明占位——非必填键不需要时请整键删除，勿原样拷贝。",
      "agentConfig": {
        "agentCard": { "pushNotifications": false },
        "events": { "enabled": "<true|false>，非必填（缺省 false：关 trace/中间调用输出；全端共享段）" },
        "opencode": {
          "systemPrompt": "<自定义 systemPrompt>，非必填（缺省注入 a2a-outcome 约定）",
          "systemPromptMode": "<append|replace>，非必填（缺省 append）"
        },
        "timeouts": { "prompt": "<毫秒数>，非必填（wrapper 族通用；不配用内置缺省）" }
      }
    },
    {
      "projectId": "<codex-project-id>",
      "workspace": "<absolute path to the codex project on this machine>",
      "agentKind": "codex",
      "a2aPort": 3011,
      "risk": "write",
      "_agentConfigComment": "本条目 agentConfig 为键位说明占位——非必填键不需要时请整键删除，勿原样拷贝。",
      "agentConfig": {
        "codex": {
          "skipGitRepoCheck": "<true|false>，非必填（缺省 true：workspace 无需是 git 仓库）",
          "developerInstructions": "<开发者指令>，非必填（缺省注入 a2a-outcome 约定）"
        }
      }
    },
    {
      "projectId": "<claude-project-id>",
      "workspace": "<absolute path to the claude project on this machine>",
      "agentKind": "claude",
      "a2aPort": 3012,
      "risk": "read",
      "_agentConfigComment": "本条目 agentConfig 为键位说明占位——非必填键不需要时请整键删除，勿原样拷贝。",
      "agentConfig": {
        "claude": {
          "settingSources": "<[\"user\"]｜[]>，非必填（缺省 [\"user\"]：加载 ~/.claude/settings.json；[] = 完全隔离用户级配置）",
          "model": "<模型名>，非必填（缺省用 ~/.claude/settings.json 的模型）",
          "systemPromptAppend": "<追加 systemPrompt>，非必填（缺省注入 a2a-outcome 约定）"
        }
      }
