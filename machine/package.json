{
  "name": "@a2a-coding/machine",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc -p tsconfig.json",
    "launcher": "npm run build && node dist/launcher/index.js",
    "start": "node scripts/launcherctl.mjs start",
    "stop": "node scripts/launcherctl.mjs stop",
    "restart": "node scripts/launcherctl.mjs restart",
    "status": "node scripts/launcherctl.mjs status",
    "logs": "node scripts/launcherctl.mjs logs",
    "reap": "node scripts/reaper.mjs",
    "zip": "node scripts/pack.mjs"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0"
  }
}
