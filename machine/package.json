{
  "name": "@a2a-coding/machine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc -p tsconfig.json",
    "launcher": "npm run build && node dist/launcher/index.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "a2a-claude": "^0.4.1",
    "a2a-codex": "^1.7.2",
    "a2a-opencode": "^1.7.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0"
  }
}
