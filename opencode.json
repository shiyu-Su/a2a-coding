{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-openagent@latest"],
  "instructions": ["flow/spec/需求流程.md", "flow/spec/引擎映射.md"],
  "mcp": {
    "a2a": {
      "type": "remote",
      "url": "http://127.0.0.1:8787/a2a-coding/mcp",
      "enabled": true
    }
  },
  "permission": {
    "edit": {
      "orch/**": "allow",
      "machine/**": "allow",
      "flow/**": "allow"
    },
    "read": {
      "orch/**": "allow",
      "machine/**": "allow",
      "flow/**": "allow"
    },
    "grep": {
      "orch/**": "allow",
      "machine/**": "allow",
      "flow/**": "allow"
    }
  }
}
